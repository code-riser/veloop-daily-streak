PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/veloop?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated browser origins. Local is always allowed in development.
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
GOOGLE_CLIENT_ID=your_google_web_client_id
# GOOGLE_CLIENT_SECRET is not required for Google Identity Services ID-token verification.
